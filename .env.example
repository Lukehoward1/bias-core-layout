# ── API keys ──────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to source control.

VITE_SUPABASE_URL=
SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
FMP_API_KEY=
TWELVE_DATA_API_KEY=

# ── Feature flags ──────────────────────────────────────────────
# Use calendar fixture data instead of live FMP economic calendar.
VITE_USE_CALENDAR_FIXTURES=false

# Generate deterministic mock candles in dev (zero Twelve Data credits).
# Set to true in .env.local for local UI work. Has no effect in production
# builds (guarded by import.meta.env.DEV — tree-shaken by Vite/Rollup).
VITE_MOCK_CANDLES=false
