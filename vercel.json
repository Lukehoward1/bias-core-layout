{
  "rewrites": [
    { "source": "/((?!api/|@|src|node_modules).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron?job=downgrade-enforce",     "schedule": "0 0 * * *" },
    { "path": "/api/cron?job=orphan-detect",         "schedule": "0 6 * * *" },
    { "path": "/api/cron?job=cancellation-digest",   "schedule": "0 8 * * 5" },
    { "path": "/api/cron?job=trial-ending-reminder", "schedule": "0 9 * * *" },
    { "path": "/api/cron?job=winback",               "schedule": "0 10 * * *" }
  ]
}
